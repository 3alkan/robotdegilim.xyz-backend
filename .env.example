# App Settings
PROJECT_NAME="robotdegilim.xyz API"
PROJECT_DESCRIPTION="Backend for robotdegilim.xyz"
VERSION="0.1.0"
API_V1_STR="/api/v1"
TIMEZONE="Europe/Istanbul"

# CORS Settings (Written as a JSON list for Pydantic to parse)
BACKEND_CORS_ORIGINS='["*"]'

# S3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL="INFO"
LOG_JSON=false
LOG_TO_FILE=false
LOG_FILE_PATH="logs/app.log"

# Worker
WORKER_POLL_INTERVAL=10

# Anti-Ban (HumanizedClient) Settings
HUMANIZED_CLIENT_MIN_DELAY_SEC=1.5
HUMANIZED_CLIENT_MAX_DELAY_SEC=3.5
HUMANIZED_CLIENT_MAX_RETRIES=3
HUMANIZED_CLIENT_BROWSER="chrome120"
